Cell[CellGroupData[{

Cell["Fill Hamiltonian Matrix", "Subsection",
 CellChangeTimes->{{3.960584788531624*^9, 
  3.960584825654401*^9}},ExpressionUUID->"a698b31c-27bc-4653-955c-\
b429759c067b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Kinetic", "=", 
   RowBox[{"ParallelTable", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"ki", ".", "ki"}], " ", 
      RowBox[{"KroneckerDelta", "[", 
       RowBox[{
        RowBox[{"ki", "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", 
        RowBox[{"kj", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], "]"}], 
      RowBox[{"KroneckerDelta", "[", 
       RowBox[{
        RowBox[{"ki", "[", 
         RowBox[{"[", "2", "]"}], "]"}], ",", 
        RowBox[{"kj", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"ki", ",", "kGrid"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"kj", ",", "kGrid"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Potential", "=", 
   RowBox[{"ParallelTable", "[", 
    RowBox[{
     FractionBox[
      RowBox[{"1.", " "}], 
      RowBox[{
       RowBox[{"Norm", "[", 
        RowBox[{"ki", "-", "kj"}], "]"}], "+", "\[Delta]k"}]], ",", 
     RowBox[{"{", 
      RowBox[{"ki", ",", "kGrid"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"kj", ",", "kGrid"}], "}"}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.960504084642407*^9, 3.960504242320785*^9}, {
   3.960504342592135*^9, 3.9605043640870533`*^9}, {3.960504423608883*^9, 
