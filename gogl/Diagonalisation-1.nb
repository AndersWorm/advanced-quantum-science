Cell[BoxData[{
 RowBox[{
  RowBox[{"N0", "=", "20"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"kmax", "=", "1."}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Delta]k", "=", 
   FractionBox["kmax", "N0"]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Alpha]", "=", 
    RowBox[{"1", "/", "\[Delta]k"}]}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{"Somewhat", " ", "arbitrary", " ", "choice"}], " ", "*)"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Kinetic", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      SuperscriptBox["i", "2"], 
      RowBox[{"KroneckerDelta", "[", 
       RowBox[{"i", ",", "j"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", 
       RowBox[{"-", "kmax"}], ",", "kmax", ",", "\[Delta]k"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", 
       RowBox[{"-", "kmax"}], ",", "kmax", ",", "\[Delta]k"}], "}"}]}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Potential", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"\[Delta]k", 
      FractionBox["\[Alpha]", 
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{"i", "-", "j"}], "]"}], "+", "\[Delta]k"}]]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", 
       RowBox[{"-", "kmax"}], ",", "kmax", ",", "\[Delta]k"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", 
       RowBox[{"-", "kmax"}], ",", "kmax", ",", "\[Delta]k"}], "}"}]}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"kTab", "=", 
   RowBox[{"Table", "[", 
    RowBox[{"i", ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", 
       RowBox[{"-", "kmax"}], ",", "kmax", ",", "\[Delta]k"}], "}"}]}], 
    "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.960504084642407*^9, 3.960504242320785*^9}, {
  3.960504342592135*^9, 3.9605043640870533`*^9}, {3.960504423608883*^9, 
